# ---- Server ----
PORT=8080

# ---- Database ----
DATABASE_URL=jdbc:postgresql://localhost:5432/portfolio
DATABASE_USER=portfolio
DATABASE_PASSWORD=portfolio

# ---- Auth (single admin) ----
# JWT_SECRET must be at least 32 characters. Generate one:  openssl rand -base64 48
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
JWT_TTL_MINUTES=120

# ---- Password recovery email (Resend) ----
# Leave RESEND_API_KEY empty in dev: emails are logged to the console instead.
RESEND_API_KEY=
EMAIL_FROM=Portfolio <onboarding@resend.dev>
FRONTEND_URL=http://localhost:4200
RESET_TOKEN_TTL_MINUTES=15
RESET_RATE_WINDOW_MINUTES=10
RESET_RATE_MAX=3

# ---- CORS (comma-separated exact origins) ----
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ---- Uploads / storage ----
# local (dev only — Render free tier has no persistent disk) | cloudinary (production)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:8080
MAX_UPLOAD_BYTES=5242880
# Required when STORAGE_DRIVER=cloudinary  (from Cloudinary dashboard "API Environment variable")
CLOUDINARY_URL=
CLOUDINARY_FOLDER=portfolio

# ---- Seed ----
# Insert sample portfolio content on first boot when the DB is empty
SEED_SAMPLE_DATA=true
