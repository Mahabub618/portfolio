{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://portfolio-api-698b.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://portfolio-api-698b.onrender.com/uploads/:path*" },
    { "source": "/((?!api|uploads).*)", "destination": "/index.html" }
  ]
}
